<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="bootstrap/app.php"
         cacheDirectory=".phpunit.cache"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
        <exclude>
            <directory>./app/Console</directory>
            <directory>./app/Exceptions</directory>
            <directory>./app/Providers</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_KEY" value="base64:MHSoTREmGGHg8ZZViir39f1f+b8xv4zYX/FKNWHDnro="/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="MAIL_DRIVER" value="array"/>
        <!-- Ninguna prueba puede llegar a la cuenta de correo real del .env:
             el envío propio (CorreoService) usa estos datos, no MAIL_MAILER. -->
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="MAIL_TRANSPORTE" value="smtp" force="true"/>
        <env name="MAIL_TRANSPORTE_RESPALDO" value="" force="true"/>
        <env name="MAIL_HOST" value="127.0.0.1" force="true"/>
        <env name="MAIL_PORT" value="9" force="true"/>
        <env name="MAIL_USERNAME" value="prueba@example.com" force="true"/>
        <env name="MAIL_PASSWORD" value="no-es-una-clave" force="true"/>
        <env name="RESEND_API_KEY" value="" force="true"/>
        <env name="QUEUE_DRIVER" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
