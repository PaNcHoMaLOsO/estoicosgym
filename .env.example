APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL, que es lo que usa el servidor. Ver docs/INSTALACION.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dbestoicos
DB_USERNAME=estoicos
DB_PASSWORD=

SESSION_DRIVER=database
# En el servidor, con https: true (la sesión no viaja sin cifrar).
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ════════════════════════════════════════════════════════
# CONFIGURACIÓN DE EMAIL
# ════════════════════════════════════════════════════════

# Opciones de MAIL_MAILER:
# - log: Solo guarda en logs (desarrollo sin envío real)
# - smtp: Envía emails reales (producción/testing)

MAIL_MAILER=smtp
MAIL_SCHEME=null

# ──────────────────────────────────────────────────────
# OPCIÓN 1: GMAIL (principal)
# ──────────────────────────────────────────────────────
# Requiere "Contraseña de aplicación" de 16 caracteres (NO tu clave normal):
# 1. Habilitar 2FA:      https://myaccount.google.com/security
# 2. Crear App Password: https://myaccount.google.com/apppasswords
# 3. Pégala sin espacios en MAIL_PASSWORD.
# Con Gmail, MAIL_FROM_ADDRESS debe ser la misma cuenta de MAIL_USERNAME.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_16_caracteres
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="PRO GYM"

# ════════════════════════════════════════════════════════
# POR DONDE SALEN LOS CORREOS
# ════════════════════════════════════════════════════════
# Todo el sistema envia por App\Services\CorreoService, asi que esto manda
# sobre las notificaciones automaticas, los avisos manuales y los codigos
# de verificacion.
#
#   smtp   -> PHPMailer contra MAIL_HOST (Gmail, arriba). Es el de siempre.
#   resend -> la API de Resend.
MAIL_TRANSPORTE=smtp

# Si el principal falla, se reintenta por aqui. Vacio = sin respaldo.
# Conviene tenerlo: Gmail corta a los 500 correos diarios, y un aviso de
# vencimiento que no sale es un socio que no renueva.
MAIL_TRANSPORTE_RESPALDO=

# Clave de https://resend.com/api-keys
# OJO: Resend solo envia desde un dominio VERIFICADO en su panel. Con una
# direccion @gmail.com en MAIL_FROM_ADDRESS rechaza el envio.
RESEND_API_KEY=

# Espera maxima por envio, en segundos. PHPMailer usa 300 por defecto, y un
# servidor que no contesta dejaba la peticion colgada cinco minutos.
MAIL_TIMEOUT=15

# ──────────────────────────────────────────────────────
# OPCIÓN 2: SENDER.NET (alternativa)
# ────────────────────────────────────────────
# Plan gratuito: 2.500 emails/mes. Crear cuenta en https://www.sender.net/
# y activar SMTP en Settings → SMTP Settings.
#
# MAIL_HOST=smtp.sender.net
# MAIL_PORT=587
# MAIL_USERNAME=tu_email@ejemplo.com
# MAIL_PASSWORD=SND_tu_token_aqui
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=tu_email@ejemplo.com
# MAIL_FROM_NAME="Estoicos Gym"

# ──────────────────────────────────────────────────────
# OPCIÓN 3: MAILTRAP (solo para desarrollo)
# ──────────────────────────────────────────────────────
# No envía emails reales, solo los captura para testing
# Ideal para desarrollo local sin spam
#
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=tu_username_mailtrap
# MAIL_PASSWORD=tu_password_mailtrap
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@estoicosgym.local
# MAIL_FROM_NAME="Estoicos Gym [DEV]"

# ──────────────────────────────────────────────────────
# DESARROLLO LOCAL (sin envío)
# ──────────────────────────────────────────────────────
# Para desarrollo sin enviar emails reales:
# MAIL_MAILER=log
# (Los emails se guardan en storage/logs/laravel.log)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
